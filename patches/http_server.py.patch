 logger = logging.getLogger('http')
 
+# local patch: how long to keep the parec/encoder pipeline warm after the
+# renderer drops the HTTP stream. Renderers like the CelMus DR70 repeatedly
+# close the connection and re-GET the same URL; keeping the pipeline alive
+# lets a re-pull attach to the running pipeline (no restart gap). After this
+# period the session is torn down as usual.
+STREAM_LINGER_SECS = 15
+# local patch: when parec ends unexpectedly, retry a fresh
+# SetAVTransportURI + Play this many times before giving up.
+PAREC_RESTART_MAX = 3
+PAREC_RESTART_DELAY = 2
+# The retry budget is refilled only after a restarted stream has run this
+# long without parec dying again (otherwise a flapping stream would restart
+# forever, since every successful pull is a new start_track()).
+PAREC_RESTART_STABLE_SECS = 60
+
 # A stream with a throughput of 1 Mbps sends 2048 bytes every 15.6 msecs.
