+        except (StopIteration, AttributeError, TypeError, ValueError):
+            pass
+
+        # The whole 'sink_properties' value must be one quoted string,
+        # otherwise the extra property is parsed as a separate (unknown)
+        # module argument, which PulseAudio rejects. module-null-sink has
+        # no 'source_properties': the monitor shares the sink's node.
+        desc = renderer.description.replace("'", '').replace('"', '')
+        sink_args = (f'sink_name="{module_name}" '
+                     f'sink_properties="device.description=\'{desc}\''
+                     ' session.suspend-timeout-seconds=0"')
+        if sink_rate:
+            sink_args += f' rate={sink_rate}'
+
