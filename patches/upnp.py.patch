+def _parse_lastchange(body):
+    """Parse a GENA event body into {stateVariable: value}.
+
+    The body is an '<e:propertyset>' with a '<LastChange>' property whose
+    value is an XML-escaped '<Event>' document of AVT/RCS InstanceID and
+    state-variable elements carrying their value in a 'val' attribute.
+    """
+    state_vars = {}
+    if not body:
+        return state_vars
+    try:
+        root = xml.etree.ElementTree.fromstring(body)
+    except xml.etree.ElementTree.ParseError:
+        return state_vars
+    for el in root.iter():
+        tag = el.tag
+        name = tag.split('}', 1)[-1] if tag.startswith('{') else tag
+        if name != 'LastChange':
+            continue
+        text = el.text
+        if not text:
+            break
+        try:
+            event = xml.etree.ElementTree.fromstring(text)
+        except xml.etree.ElementTree.ParseError:
+            break
+        for var in event.iter():
+            vtag = var.tag
+            vname = vtag.split('}', 1)[-1] if vtag.startswith('{') else vtag
+            if vname != 'InstanceID' and 'val' in var.attrib:
+                state_vars[vname] = var.attrib['val']
+        break
+    return state_vars
