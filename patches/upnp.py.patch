+    # local patch: GENA event subscription (UPnP eventing).
+
+    async def subscribe(self, callback_url, timeout=300, listener=None):
+        """Subscribe to this service's event notifications (GENA).
+
+        'callback_url' is the URL the device delivers NOTIFY events to (must
+        be reachable from the device). 'listener' is a callable called with a
+        dict {stateVariable: value} on each event.
+        """
+        if self.eventSubURL is None:
+            return None
+        self.event_listener = listener
+        self._event_timeout = timeout
+        header = (f'Callback: <{callback_url}>\r\n'
+                  f'NT: upnp:event\r\n'
+                  f'Timeout: Second-{timeout}\r\n')
+        header_lines, _ = await http_subscribe(self.eventSubURL, header)
+        hd = http_header_as_dict(header_lines[1:])
+        sid = hd.get('SID')
+        if sid is None:
+            raise UPnPError(f'subscribe() failed on {self}:'
+                            f' {header_lines!r}')
+        self.sid = sid
+        self.root_device._control_point._register_subscription(sid, self)
+        self._renew_task = asyncio.ensure_future(self._renew())
+        return sid
+
+    async def _renew(self):
+        """Keep the subscription alive by renewing before it expires."""
+        timeout = self._event_timeout or 300
+        try:
+            while self.sid is not None and not self.closed:
+                await asyncio.sleep(max(timeout - 15, 10))
+                if self.sid is None or self.closed:
+                    break
+                header = (f'SID: {self.sid}\r\n'
+                          f'Timeout: Second-{timeout}\r\n')
+                try:
+                    await http_subscribe(self.eventSubURL, header)
+                except Exception as e:
+                    logger.warning(f'{self}: event subscription renewal'
+                                   f' failed: {e!r}')
+        except asyncio.CancelledError:
+            pass
+        finally:
+            self._renew_task = None
+
+    async def unsubscribe(self):
+        if self.sid is None:
+            return
+        sid = self.sid
+        self.sid = None
+        if (self._renew_task is not None and
+                self._renew_task is not asyncio.current_task()):
+            self._renew_task.cancel()
+            self._renew_task = None
+        self.root_device._control_point._unregister_subscription(sid)
+        try:
+            await http_unsubscribe(self.eventSubURL, f'SID: {sid}\r\n')
+        except Exception as e:
+            logger.debug(f'{self}: unsubscribe failed: {e!r}')
+
+    def _on_event(self, state_vars):
+        if self.event_listener is not None:
+            self.event_listener(state_vars)
