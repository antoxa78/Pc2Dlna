+    # local patch: GENA event server and subscription registry.
+
+    def _callback_url(self):
+        ip = next(iter(self.ip_monitored), None) or '127.0.0.1'
+        return f'http://{ip}:{self._event_port}/notify'
+
+    def _register_subscription(self, sid, service):
+        self._subscriptions[sid] = service
+
+    def _unregister_subscription(self, sid):
+        self._subscriptions.pop(sid, None)
+
+    def _deliver_event(self, sid, body):
+        service = self._subscriptions.get(sid)
+        if service is None:
+            logger.debug(f'GENA event for unknown SID {sid}')
+            return
+        state_vars = _parse_lastchange(body)
+        logger.debug(f'GENA event from {service}: {state_vars}')
+        if state_vars:
+            service._on_event(state_vars)
+
+    async def _run_event_server(self):
+        try:
+            self._event_server = await asyncio.start_server(
+                self._event_client, '0.0.0.0', 0)
+            self._event_port = self._event_server.sockets[0].getsockname()[1]
+            logger.info(f'GENA event server listening on port'
+                        f' {self._event_port}')
+            async with self._event_server:
+                await self._event_server.serve_forever()
+        except asyncio.CancelledError:
+            pass
+        except Exception as e:
+            log_exception(logger, f'GENA event server: {e!r}')
+
+    async def _event_client(self, reader, writer):
+        try:
+            req_line = await reader.readline()
+            if not req_line:
+                return
+            parts = req_line.decode('latin1').rstrip().split()
+            if len(parts) < 2:
+                return
+            method = parts[0]
+            headers = {}
+            while True:
+                line = await reader.readline()
+                if not line:
+                    return
+                line = line.decode('latin1').rstrip()
+                if not line:
+                    break
+                if ':' in line:
+                    k, v = line.split(':', 1)
+                    headers[k.strip().upper()] = v.strip()
+            content_length = int(headers.get('CONTENT-LENGTH', '0') or '0')
+            body = b''
+            if content_length:
+                body = await reader.readexactly(content_length)
+            if method == 'NOTIFY':
+                logger.debug(f'GENA NOTIFY received: SID={headers.get("SID")}'
+                             f' SEQ={headers.get("SEQ")}')
+                self._deliver_event(headers.get('SID'), body)
+            writer.write(b'HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n')
+            await writer.drain()
+        except (asyncio.IncompleteReadError, ConnectionError):
+            pass
+        except Exception as e:
+            log_exception(logger, f'GENA event client: {e!r}')
+        finally:
+            try:
+                writer.close()
+                await writer.wait_closed()
+            except (ConnectionError, OSError):
+                pass
